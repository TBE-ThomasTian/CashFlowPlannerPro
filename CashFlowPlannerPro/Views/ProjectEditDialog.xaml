<Window x:Class="CashFlowPlannerPro.Views.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projekt bearbeiten" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" KeyDown="Window_KeyDown">
    <Border Background="#2A2359" CornerRadius="12" Padding="32" MinWidth="450"
            BorderBrush="#812B8C" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="DialogTitle" Text="Projekt bearbeiten" FontSize="20" FontWeight="Bold"
                       Foreground="#BF247A" Margin="0,0,0,20"/>

            <TextBlock Text="Projektnummer" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TbProjectNumber" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Projektname" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TbName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Auftraggeber" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CbClient" IsEditable="True" Margin="0,0,0,12"
                      Background="#1E1A40" Foreground="White" BorderBrush="#3D3670" BorderThickness="1"
                      FontSize="14" Padding="8,6"/>

            <TextBlock Text="Farbe" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <WrapPanel x:Name="ColorPicker" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border x:Name="ColorPreview" Width="28" Height="28" CornerRadius="4" Margin="0,0,8,0"
                        BorderBrush="#3D3670" BorderThickness="1"/>
                <TextBox x:Name="TbCustomColor" Style="{StaticResource DarkTextBox}" Width="120"
                         TextChanged="TbCustomColor_TextChanged" ToolTip="Hex-Farbcode z.B. #FF5733"/>
                <TextBlock Text="  eigene Farbe (Hex)" Foreground="#667788" FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ausgangswert (€)"
                           Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Rabatt (%)"
                           Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="TbOriginalBudget" Grid.Row="1" Grid.Column="0"
                         Style="{StaticResource DarkTextBox}" TextChanged="TbOriginalBudget_TextChanged"
                         ToolTip="Projektwert vor Abzug des Rabatts"/>
                <TextBox x:Name="TbDiscountPercent" Grid.Row="1" Grid.Column="2"
                         Style="{StaticResource DarkTextBox}" TextChanged="TbDiscountPercent_TextChanged"
                         ToolTip="Rabatt zwischen 0 und 100 Prozent"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Rabatt (€)"
                           Foreground="#8899AA" FontSize="11" Margin="0,8,0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Projektbudget / Endbetrag (€)"
                           Foreground="#8899AA" FontSize="11" Margin="0,8,0,4"/>
                <TextBox x:Name="TbDiscountAmount" Grid.Row="3" Grid.Column="0"
                         Style="{StaticResource DarkTextBox}" TextChanged="TbDiscountAmount_TextChanged"
                         ToolTip="Rabattbetrag zwischen 0 und dem Ausgangswert"/>
                <TextBox x:Name="TbBudget" Grid.Row="3" Grid.Column="2"
                         Style="{StaticResource DarkTextBox}" IsReadOnly="True" IsTabStop="False"
                         Background="#16132F" ToolTip="Automatisch berechneter Endbetrag"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Startdatum" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Enddatum" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                <DatePicker x:Name="DpStart" Grid.Row="1" Grid.Column="0" Loaded="DatePicker_FixStyle"
                            Background="#1E1A40" Foreground="White" BorderBrush="#3D3670" BorderThickness="1" FontSize="14" Padding="4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="–" Foreground="White" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <DatePicker x:Name="DpEnd" Grid.Row="1" Grid.Column="2" Loaded="DatePicker_FixStyle"
                            Background="#1E1A40" Foreground="White" BorderBrush="#3D3670" BorderThickness="1" FontSize="14" Padding="4"/>
            </Grid>

            <TextBlock Text="Status" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CbStatus" Margin="0,0,0,20" Background="#1E1A40" Foreground="White"
                      BorderBrush="#3D3670" BorderThickness="1">
                <ComboBoxItem Content="active"/>
                <ComboBoxItem Content="paused"/>
                <ComboBoxItem Content="completed"/>
                <ComboBoxItem Content="cancelled"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="Abbrechen" Click="Cancel_Click" MinWidth="100"
                        Margin="0,0,12,0" Padding="12,8" FontSize="13" Cursor="Hand"
                        Background="#3D3670" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="SaveBtn" Content="Speichern" Click="Save_Click" MinWidth="100"
                        Padding="12,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                        Background="#BF247A" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
