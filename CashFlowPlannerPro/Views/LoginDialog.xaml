<Window x:Class="CashFlowPlannerPro.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CashFlowPlannerPro.Services"
        Title="CashFlow Planner Pro - Anmeldung"
        Width="1000" Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        KeyDown="Window_KeyDown"
        services:UiScaleService.IsScalingEnabled="False">
    <Border Background="#2A2359" CornerRadius="12" BorderBrush="#812B8C" BorderThickness="2" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Draggable title bar -->
        <Border Grid.Row="0" Background="Transparent" Padding="0,8,12,0"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right"
                    FontSize="16" Foreground="#8899AA" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" Padding="8,2"
                    VerticalAlignment="Top" ToolTip="Schließen">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: Login Form -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="50,10,40,40" Padding="0,0,14,0">
            <StackPanel VerticalAlignment="Center">
                <!-- Title -->
                <TextBlock x:Name="TitleText" Text="CashFlow Planner Pro"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,5" />
                <TextBlock x:Name="SubtitleText" Text="Melden Sie sich bei Ihrem Konto an"
                           FontSize="14" Foreground="#94A3B8"
                           Margin="0,0,0,30" />

                <!-- Section 1: Database -->
                <Expander x:Name="DatabaseExpander"
                          IsExpanded="False"
                          Margin="0,0,0,18"
                          Foreground="White">
                    <Expander.Header>
                        <TextBlock x:Name="DatabaseStepText" Text="1. Datenbank wählen"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#CBD5E1"/>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <!-- Backend Toggle -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbSqlite" Grid.Column="0" Content="  Lokale Datei"
                                         GroupName="Backend" IsChecked="True" Foreground="White" FontSize="13"
                                         VerticalContentAlignment="Center" Cursor="Hand"
                                         Checked="BackendToggle_Changed"/>
                            <RadioButton x:Name="RbMariaDb" Grid.Column="2" Content="  Server (MariaDB)"
                                         GroupName="Backend" Foreground="White" FontSize="13"
                                         VerticalContentAlignment="Center" Cursor="Hand"
                                         Checked="BackendToggle_Changed"/>
                        </Grid>

                        <!-- SQLite Panel -->
                        <StackPanel x:Name="PanelSqlite">
                            <Border Background="#3A3370" CornerRadius="6"
                                    Padding="12,10" Margin="0,0,0,10">
                                <TextBlock x:Name="DbPathText"
                                           Text="Keine Datenbank ausgewählt"
                                           Foreground="#94A3B8" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Border>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="OpenDbButton" Grid.Column="0"
                                        Content="Öffnen" Height="36"
                                        Background="#3A3370" Foreground="White"
                                        BorderBrush="#4A4380" BorderThickness="1"
                                        Cursor="Hand" Click="OpenDbButton_Click"/>
                                <Button x:Name="NewDbButton" Grid.Column="2"
                                        Content="Neu" Height="36"
                                        Background="#3A3370" Foreground="White"
                                        BorderBrush="#4A4380" BorderThickness="1"
                                        Cursor="Hand" Click="NewDbButton_Click"/>
                            </Grid>
                            <Button x:Name="ImportServerBtn" Content="📥 Von Server importieren" Click="ImportFromMariaDb_Click" Height="30"
                                    Background="Transparent" Foreground="#64748B" BorderBrush="#4A4380" BorderThickness="1"
                                    Cursor="Hand" FontSize="11" Margin="0,0,0,4"/>
                        </StackPanel>

                        <!-- MariaDB Panel -->
                        <StackPanel x:Name="PanelMariaDb" Visibility="Collapsed">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Host" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TbMariaHost" Text="localhost" FontSize="13" Foreground="White" CaretBrush="White"
                                             Background="#3A3370" BorderBrush="#4A4380" Padding="10,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TbMariaPort" Text="3306" FontSize="13" Foreground="White" CaretBrush="White"
                                             Background="#3A3370" BorderBrush="#4A4380" Padding="10,8"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Datenbank" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TbMariaDatabase" Text="cashflow" FontSize="13" Foreground="White" CaretBrush="White"
                                     Background="#3A3370" BorderBrush="#4A4380" Padding="10,8" Margin="0,0,0,6"/>
                            <TextBlock Text="DB-Benutzer" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TbMariaUser" Text="root" FontSize="13" Foreground="White" CaretBrush="White"
                                     Background="#3A3370" BorderBrush="#4A4380" Padding="10,8" Margin="0,0,0,6"/>
                            <TextBlock Text="DB-Passwort" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3"/>
                            <PasswordBox x:Name="PbMariaPassword" FontSize="13" Foreground="White" CaretBrush="White"
                                         Background="#3A3370" BorderBrush="#4A4380" Padding="10,8" MinHeight="38" Margin="0,0,0,6"/>
                            <Button x:Name="TestConnectionBtn" Content="Verbindung testen" Click="TestMariaDbConnection_Click" Height="42"
                                    Background="#3A3370" Foreground="White" BorderBrush="#4A4380" BorderThickness="1"
                                    Cursor="Hand" Margin="0,0,0,6" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TbMariaStatus" Text="" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"
                                       TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button x:Name="ImportLocalBtn" Content="📥 Lokale DB importieren" Click="ImportFromSqlite_Click" Height="30"
                                    Background="Transparent" Foreground="#64748B" BorderBrush="#4A4380" BorderThickness="1"
                                    Cursor="Hand" FontSize="11" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <!-- Spacer before login section -->
                <Border Height="4"/>

                <!-- Section 2: Login -->
                <TextBlock x:Name="SignInStepText" Text="2. Anmelden"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#CBD5E1" Margin="0,0,0,10" />
                <Grid MinHeight="42" Margin="0,0,0,10">
                    <TextBox x:Name="UsernameTextBox"
                             FontSize="14" Foreground="White" CaretBrush="White"
                             Background="#3A3370" BorderBrush="#4A4380" BorderThickness="1"
                             VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    Padding="10,10">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="#BF247A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Popup x:Name="UsernamePopup" PlacementTarget="{Binding ElementName=UsernameTextBox}"
                           Placement="Bottom" StaysOpen="False"
                           Width="{Binding ActualWidth, ElementName=UsernameTextBox}">
                        <ListBox x:Name="UsernameListBox" Background="#3A3370" Foreground="White"
                                 BorderBrush="#4A4380" SelectionChanged="UsernameListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#334155"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#4A4380"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#4A4380"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Popup>
                </Grid>
                <TextBlock x:Name="UsernamePlaceholder"
                           Text="Benutzername"
                           Foreground="#64748B" FontSize="14"
                           Margin="12,0,0,10" IsHitTestVisible="False"
                           VerticalAlignment="Top"
                           Visibility="Visible" />
                <PasswordBox x:Name="PasswordBox"
                             MinHeight="42" Margin="0,0,0,10"
                             FontSize="14" Foreground="White"
                             Background="#3A3370" CaretBrush="White"
                             BorderBrush="#4A4380" BorderThickness="1"
                             VerticalContentAlignment="Center">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                Padding="10,10">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="#BF247A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
                <CheckBox x:Name="ChkRememberSettings" Content="  Einstellungen merken"
                         Foreground="#94A3B8" FontSize="12" Cursor="Hand"
                         Margin="0,0,0,8" VerticalContentAlignment="Center"
                         ToolTip="Verbindungsdaten verschlüsselt auf diesem PC speichern"/>
                <TextBlock x:Name="ErrorText"
                           Text="" Foreground="#EF4444"
                           FontSize="12" Margin="0,0,0,10"
                           Visibility="Collapsed"
                           TextWrapping="Wrap" />
                <Button x:Name="LoginButton"
                        Content="Anmelden" Height="42"
                        FontSize="15" FontWeight="SemiBold"
                        Background="#BF247A" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,5,0,0"
                        Click="LoginButton_Click" />
                <Button x:Name="DemoButton"
                        Content="Demo starten" Height="42"
                        FontSize="14" FontWeight="SemiBold"
                        Background="#3A3370" Foreground="White"
                        BorderBrush="#4A4380" BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,10,0,0"
                        Click="DemoButton_Click" />

                <TextBlock x:Name="VersionText" Text="v2.1.0"
                           Foreground="#4A4380" FontSize="11"
                           HorizontalAlignment="Left" Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Side: Decorative Panel -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3A3370" Offset="0" />
                    <GradientStop Color="#2A2359" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Image Source="/Resources/CashFlowLoginIcon.png"
                   Width="280" Height="280"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
        </Grid>

        <Border x:Name="BusyOverlay"
                Grid.RowSpan="2"
                Background="#AA1E183F"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Width="220"
                             Height="8"
                             IsIndeterminate="True"/>
                <TextBlock x:Name="BusyText"
                           Text="Bitte warten..."
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
