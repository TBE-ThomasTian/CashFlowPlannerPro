<Window x:Class="CashFlowPlannerPro.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CashFlow Planner Pro - Anmeldung"
        Width="1000" Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="#2A2359">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: Login Form -->
        <Grid Grid.Column="0" Margin="50,40,40,40">
            <StackPanel VerticalAlignment="Center">
                <!-- Title -->
                <TextBlock Text="CashFlow Planner Pro"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,5" />
                <TextBlock Text="Melden Sie sich bei Ihrem Konto an"
                           FontSize="14" Foreground="#94A3B8"
                           Margin="0,0,0,30" />

                <!-- Section 1: Database -->
                <TextBlock Text="1. Datenbank wählen"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#CBD5E1" Margin="0,0,0,10" />
                <Border Background="#3A3370" CornerRadius="6"
                        Padding="12,10" Margin="0,0,0,10">
                    <TextBlock x:Name="DbPathText"
                               Text="Keine Datenbank ausgewählt"
                               Foreground="#94A3B8" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Border>
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenDbButton" Grid.Column="0"
                            Content="Öffnen" Height="36"
                            Background="#3A3370" Foreground="White"
                            BorderBrush="#4A4380" BorderThickness="1"
                            Cursor="Hand" Click="OpenDbButton_Click" />
                    <Button x:Name="NewDbButton" Grid.Column="2"
                            Content="Neu" Height="36"
                            Background="#3A3370" Foreground="White"
                            BorderBrush="#4A4380" BorderThickness="1"
                            Cursor="Hand" Click="NewDbButton_Click" />
                </Grid>

                <!-- Section 2: Login -->
                <TextBlock Text="2. Anmelden"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#CBD5E1" Margin="0,0,0,10" />
                <Grid MinHeight="42" Margin="0,0,0,10">
                    <TextBox x:Name="UsernameTextBox"
                             FontSize="14" Foreground="White" CaretBrush="White"
                             Background="#3A3370" BorderBrush="#4A4380" BorderThickness="1"
                             VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    Padding="10,10">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="#BF247A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Popup x:Name="UsernamePopup" PlacementTarget="{Binding ElementName=UsernameTextBox}"
                           Placement="Bottom" StaysOpen="False"
                           Width="{Binding ActualWidth, ElementName=UsernameTextBox}">
                        <ListBox x:Name="UsernameListBox" Background="#3A3370" Foreground="White"
                                 BorderBrush="#4A4380" SelectionChanged="UsernameListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#334155"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#4A4380"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#4A4380"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Popup>
                </Grid>
                <TextBlock x:Name="UsernamePlaceholder"
                           Text="Benutzername"
                           Foreground="#64748B" FontSize="14"
                           Margin="12,0,0,10" IsHitTestVisible="False"
                           VerticalAlignment="Top"
                           Visibility="Visible" />
                <PasswordBox x:Name="PasswordBox"
                             MinHeight="42" Margin="0,0,0,10"
                             FontSize="14" Foreground="White"
                             Background="#3A3370" CaretBrush="White"
                             BorderBrush="#4A4380" BorderThickness="1"
                             VerticalContentAlignment="Center">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                Padding="10,10">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="#BF247A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
                <TextBlock x:Name="ErrorText"
                           Text="" Foreground="#EF4444"
                           FontSize="12" Margin="0,0,0,10"
                           Visibility="Collapsed"
                           TextWrapping="Wrap" />
                <Button x:Name="LoginButton"
                        Content="Anmelden" Height="42"
                        FontSize="15" FontWeight="SemiBold"
                        Background="#BF247A" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,5,0,0"
                        Click="LoginButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Right Side: Decorative Panel -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3A3370" Offset="0" />
                    <GradientStop Color="#2A2359" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Image Source="/Resources/CashFlowLoginIcon.png"
                   Width="280" Height="280"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
    </Grid>
</Window>
