<Window x:Class="CashFlowPlannerPro.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CashFlow Planner Pro - Anmeldung"
        Width="1000" Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="#1a1a2e">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: Login Form -->
        <Grid Grid.Column="0" Margin="50,40,40,40">
            <StackPanel VerticalAlignment="Center">
                <!-- Title -->
                <TextBlock Text="CashFlow Planner Pro"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,5" />
                <TextBlock Text="Melden Sie sich bei Ihrem Konto an"
                           FontSize="14" Foreground="#9e9e9e"
                           Margin="0,0,0,30" />

                <!-- Section 1: Database -->
                <TextBlock Text="1. Datenbank wählen"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#e0e0e0" Margin="0,0,0,10" />
                <Border Background="#16213e" CornerRadius="6"
                        Padding="12,10" Margin="0,0,0,10">
                    <TextBlock x:Name="DbPathText"
                               Text="Keine Datenbank ausgewählt"
                               Foreground="#b0b0b0" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Border>
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenDbButton" Grid.Column="0"
                            Content="Öffnen" Height="36"
                            Background="#16213e" Foreground="White"
                            BorderBrush="#0f3460" BorderThickness="1"
                            Cursor="Hand" Click="OpenDbButton_Click" />
                    <Button x:Name="NewDbButton" Grid.Column="2"
                            Content="Neu" Height="36"
                            Background="#16213e" Foreground="White"
                            BorderBrush="#0f3460" BorderThickness="1"
                            Cursor="Hand" Click="NewDbButton_Click" />
                </Grid>

                <!-- Section 2: Login -->
                <TextBlock Text="2. Anmelden"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#e0e0e0" Margin="0,0,0,10" />
                <Grid Height="38" Margin="0,0,0,10">
                    <TextBox x:Name="UsernameTextBox"
                             FontSize="14" Foreground="White" CaretBrush="White"
                             Background="#16213e" BorderBrush="#0f3460" BorderThickness="1"
                             Padding="8,6" VerticalContentAlignment="Center"/>
                    <Popup x:Name="UsernamePopup" PlacementTarget="{Binding ElementName=UsernameTextBox}"
                           Placement="Bottom" StaysOpen="False"
                           Width="{Binding ActualWidth, ElementName=UsernameTextBox}">
                        <ListBox x:Name="UsernameListBox" Background="#16213e" Foreground="White"
                                 BorderBrush="#0f3460" SelectionChanged="UsernameListBox_SelectionChanged"/>
                    </Popup>
                </Grid>
                <TextBlock x:Name="UsernamePlaceholder"
                           Text="name@beispiel.de"
                           Foreground="#808080" FontSize="14"
                           Margin="8,0,0,10" IsHitTestVisible="False"
                           VerticalAlignment="Top"
                           Visibility="Visible" />
                <PasswordBox x:Name="PasswordBox"
                             Height="38" Margin="0,0,0,10"
                             FontSize="14" Foreground="White"
                             Background="#16213e" CaretBrush="White"/>
                <TextBlock x:Name="ErrorText"
                           Text="" Foreground="#ff4444"
                           FontSize="12" Margin="0,0,0,10"
                           Visibility="Collapsed"
                           TextWrapping="Wrap" />
                <Button x:Name="LoginButton"
                        Content="Anmelden" Height="42"
                        FontSize="15" FontWeight="SemiBold"
                        Background="#e94560" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,5,0,0"
                        Click="LoginButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Right Side: Decorative Panel -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0f3460" Offset="0" />
                    <GradientStop Color="#16213e" Offset="0.5" />
                    <GradientStop Color="#1a1a2e" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Image Source="/Resources/CashFlowLoginIcon.png"
                   Width="280" Height="280"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
    </Grid>
</Window>
