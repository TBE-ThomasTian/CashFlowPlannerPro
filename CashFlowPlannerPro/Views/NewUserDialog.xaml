<Window x:Class="CashFlowPlannerPro.Views.NewUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neuer Benutzer" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" KeyDown="Window_KeyDown">
    <Border Background="#2A2359" CornerRadius="12" Padding="32" MinWidth="380"
            BorderBrush="#812B8C" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Neuer Benutzer" FontSize="20" FontWeight="Bold"
                       Foreground="#BF247A" Margin="0,0,0,20"/>

            <TextBlock Text="Benutzername" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TbUsername" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Anzeigename" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TbFullName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Passwort" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PbPassword" Margin="0,0,0,12"
                         Background="#1E1A40" Foreground="White" CaretBrush="White"
                         BorderBrush="#3D3670" BorderThickness="1" Padding="10,8" FontSize="13"/>

            <TextBlock Text="Passwort bestätigen" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PbConfirm" Margin="0,0,0,20"
                         Background="#1E1A40" Foreground="White" CaretBrush="White"
                         BorderBrush="#3D3670" BorderThickness="1" Padding="10,8" FontSize="13"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Click="Cancel_Click" MinWidth="100"
                        Margin="0,0,12,0" Padding="12,8" FontSize="13" Cursor="Hand"
                        Background="#3D3670" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Erstellen" Click="Create_Click" MinWidth="100"
                        Padding="12,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                        Background="#BF247A" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
