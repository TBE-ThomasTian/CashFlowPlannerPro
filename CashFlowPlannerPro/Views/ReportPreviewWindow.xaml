<Window x:Class="CashFlowPlannerPro.Views.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Width="1100" Height="820"
        KeyDown="Window_KeyDown">
    <Border Background="#2A2359" CornerRadius="12" Padding="24"
            BorderBrush="#812B8C" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="□" Click="ToggleMaximize_Click" HorizontalAlignment="Right"
                        FontSize="16" Foreground="#A8B3C7" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Padding="8,2"/>
                    <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right"
                        FontSize="16" Foreground="#A8B3C7" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Padding="8,2"
                        Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Report-Vorschau"
                               FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="SubtitleText" Text="Visuelle Vorschau des Monatsreports"
                               FontSize="12" Foreground="#A8B3C7"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="#1E1A40" CornerRadius="10" BorderBrush="#3D3670" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22">
                    <Grid HorizontalAlignment="Center" MaxWidth="860">
                        <Border Background="#F7F3FB" CornerRadius="18" Padding="28" BorderBrush="#E8DDF1" BorderThickness="1">
                            <StackPanel>
                                <Border Background="#342B6C" CornerRadius="20" Padding="24" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="CompanyNameText"
                                                       Foreground="#DED8F6"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="450"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock x:Name="CompanyContactText"
                                                       Foreground="#CFC7EC"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="450"
                                                       Margin="0,0,0,12"/>
                                            <Border HorizontalAlignment="Left" Padding="12,8" CornerRadius="999" Background="#473E80">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" Fill="#F2A5CC" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Monatsreport" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock x:Name="ReportTitleText" Text="CashFlow Planner Pro"
                                                       Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,18,0,6"/>
                                            <TextBlock x:Name="ReportSubtitleText" Text="Executive Summary fuer Cashflow und operative Kennzahlen"
                                                       Foreground="#DED8F6" FontSize="13" TextWrapping="Wrap" MaxWidth="430"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Width="180">
                                            <TextBlock Text="Erstellt" Foreground="#CFC7EC" FontSize="11"/>
                                            <TextBlock x:Name="GeneratedAtText" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                            <TextBlock Text="Zeitraum" Foreground="#CFC7EC" FontSize="11"/>
                                            <TextBlock x:Name="ReportPeriodText" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="4" Margin="0,0,0,18">
                                    <Border Style="{StaticResource KpiCard}" Margin="6">
                                        <StackPanel>
                                            <TextBlock Text="Kontostand Heute" Style="{StaticResource KpiLabel}"/>
                                            <TextBlock x:Name="CurrentBalanceText" Margin="0,8,0,0"
                                                       FontSize="13" FontWeight="Bold" Foreground="#2A2359"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KpiCard}" Margin="6">
                                        <StackPanel>
                                            <TextBlock Text="Prognose Ende" Style="{StaticResource KpiLabel}"/>
                                            <TextBlock x:Name="ForecastEndText" Margin="0,8,0,0"
                                                       FontSize="13" FontWeight="Bold" Foreground="#2A2359"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KpiCard}" Margin="6">
                                        <StackPanel>
                                            <TextBlock Text="Offene Rechnungen" Style="{StaticResource KpiLabel}"/>
                                            <TextBlock x:Name="OpenInvoicesText" Margin="0,8,0,0"
                                                       FontSize="13" FontWeight="Bold" Foreground="#2A2359"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KpiCard}" Margin="6">
                                        <StackPanel>
                                            <TextBlock Text="Aktive Angebote" Style="{StaticResource KpiLabel}"/>
                                            <TextBlock x:Name="ActiveOffersText" Margin="0,8,0,0"
                                                       FontSize="13" FontWeight="Bold" Foreground="#2A2359"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Margin="0,0,10,0" Padding="18"
                                            CornerRadius="18" Background="White" BorderBrush="#E8DDF1" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Live-Finanzbild" FontSize="16" FontWeight="Bold" Foreground="#2A2359"/>
                                            <TextBlock Text="Kompakte Management-Sicht auf die aktuelle Lage" FontSize="12" Foreground="#7A7296" Margin="0,4,0,14"/>
                                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                                <Border Background="#F6F0FB" CornerRadius="14" Padding="14" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Monatl. Cashflow" FontSize="12" Foreground="#6C638A"/>
                                                        <TextBlock x:Name="MonthlyCashflowText" FontSize="16" FontWeight="Bold" Foreground="#2A2359" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F6F0FB" CornerRadius="14" Padding="14" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Burn Rate" FontSize="12" Foreground="#6C638A"/>
                                                        <TextBlock x:Name="BurnRateText" FontSize="16" FontWeight="Bold" Foreground="#2A2359" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F6F0FB" CornerRadius="14" Padding="14" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Runway" FontSize="12" Foreground="#6C638A"/>
                                                        <TextBlock x:Name="RunwayText" FontSize="16" FontWeight="Bold" Foreground="#2A2359" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F6F0FB" CornerRadius="14" Padding="14" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Stunden diesen Monat" FontSize="12" Foreground="#6C638A"/>
                                                        <TextBlock x:Name="HoursThisMonthText" FontSize="16" FontWeight="Bold" Foreground="#2A2359" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Margin="10,0,0,0" Padding="18"
                                            CornerRadius="18" Background="White" BorderBrush="#E8DDF1" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Operative Signale" FontSize="16" FontWeight="Bold" Foreground="#2A2359"/>
                                            <TextBlock Text="Kennzahlen und kritische Aufgaben" FontSize="12" Foreground="#7A7296" Margin="0,4,0,14"/>
                                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                                <Border Background="#FFF5F5" CornerRadius="14" Padding="12" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Offene ToDos" FontSize="11" Foreground="#8A7480"/>
                                                        <TextBlock x:Name="OpenTodosText" FontSize="15" FontWeight="Bold" Foreground="#BF247A" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#FFF7ED" CornerRadius="14" Padding="12" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Ueberfaellig" FontSize="11" Foreground="#8A7480"/>
                                                        <TextBlock x:Name="OverdueTodosText" FontSize="15" FontWeight="Bold" Foreground="#D9731A" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F3F7FF" CornerRadius="14" Padding="12" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Auslastung" FontSize="11" Foreground="#8A7480"/>
                                                        <TextBlock x:Name="TeamUtilizationText" FontSize="15" FontWeight="Bold" Foreground="#3659B3" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F1FBF9" CornerRadius="14" Padding="12" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Laufende Timer" FontSize="11" Foreground="#8A7480"/>
                                                        <TextBlock x:Name="RunningTimersText" FontSize="15" FontWeight="Bold" Foreground="#0F9D7A" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                            <Border Background="#FCFAFF" CornerRadius="14" Padding="14" BorderBrush="#EAE0F3" BorderThickness="1">
                                                <StackPanel x:Name="CriticalTodoPanel"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Padding="18" CornerRadius="18" Background="White" BorderBrush="#E8DDF1" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Forecast Monatswerte" FontSize="16" FontWeight="Bold" Foreground="#2A2359"/>
                                        <TextBlock x:Name="ForecastConfigText" FontSize="11" Foreground="#7A7296" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                        <Border Background="#F7F3FB" CornerRadius="12" Padding="10">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled">
                                                <Grid x:Name="MonthTableGrid"/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CloseButton" Content="Schließen" Click="Close_Click" MinWidth="120"
                        Padding="12,8" FontSize="13" Cursor="Hand"
                        Background="#3D3670" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
