<UserControl x:Class="CashFlowPlannerPro.Views.TimeTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12"
                Padding="20,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="⏱  Zeiterfassung" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#CBD5E1" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock x:Name="ProjectLabel" Text="Projekt" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ProjectCombo"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock x:Name="ActivityLabel" Text="Tätigkeit" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ActivityCombo"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock x:Name="DescriptionLabel" Text="Notiz" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <TextBox x:Name="DescriptionTextBox"/>
                </StackPanel>

                <Button x:Name="StartButton" Grid.Column="3" Content="Starten"
                        Click="StartButton_Click" Style="{StaticResource AddButton}"
                        Padding="16,8" Margin="0,20,10,0" MinWidth="110"/>
                <Button x:Name="StopButton" Grid.Column="4" Content="Stoppen"
                        Click="StopButton_Click" Style="{StaticResource DeleteButton}"
                        Padding="16,8" Margin="0,20,0,0" MinWidth="110"/>

                <Border Grid.Row="1" Grid.ColumnSpan="5" Margin="0,16,0,0"
                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                    <TextBlock x:Name="RunningEntryText" FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16">
                <DockPanel>
                    <TextBlock x:Name="RecentEntriesTitle" DockPanel.Dock="Top" Text="Letzte Einträge" FontSize="16" FontWeight="Bold"
                               Foreground="#1E293B" Margin="0,0,0,12"/>
                    <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="EntryDateColumn" Header="Datum" Binding="{Binding EntryDate}" Width="90"/>
                            <DataGridTextColumn x:Name="EntryProjectColumn" Header="Projekt" Binding="{Binding ProjectName}" Width="*"/>
                            <DataGridTextColumn x:Name="EntryActivityColumn" Header="Tätigkeit" Binding="{Binding ActivityType}" Width="140"/>
                            <DataGridTextColumn x:Name="EntryFromColumn" Header="Von" Binding="{Binding StartTime}" Width="120"/>
                            <DataGridTextColumn x:Name="EntryToColumn" Header="Bis" Binding="{Binding EndTime}" Width="120"/>
                            <DataGridTextColumn x:Name="EntryHoursColumn" Header="Stunden" Binding="{Binding DurationHours, StringFormat={}{0:N2}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock x:Name="HoursByProjectTitle" DockPanel.Dock="Top" Text="Stunden pro Projekt" FontSize="16" FontWeight="Bold"
                                   Foreground="#1E293B" Margin="0,0,0,12"/>
                        <DataGrid x:Name="ProjectSummaryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ProjectSummaryLabelColumn" Header="Projekt" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn x:Name="ProjectSummaryHoursColumn" Header="Stunden" Binding="{Binding Hours, StringFormat={}{0:N2}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="16">
                    <DockPanel>
                        <TextBlock x:Name="HoursByActivityTitle" DockPanel.Dock="Top" Text="Stunden pro Tätigkeit" FontSize="16" FontWeight="Bold"
                                   Foreground="#1E293B" Margin="0,0,0,12"/>
                        <DataGrid x:Name="ActivitySummaryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ActivitySummaryLabelColumn" Header="Tätigkeit" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn x:Name="ActivitySummaryHoursColumn" Header="Stunden" Binding="{Binding Hours, StringFormat={}{0:N2}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
