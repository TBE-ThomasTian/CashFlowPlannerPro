<UserControl x:Class="CashFlowPlannerPro.Views.IntegrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12"
                Padding="20,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="🧩 Add-ons" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SubtitleText" Text="Drittanbieter sicher verbinden und Daten kontrolliert übernehmen"
                           FontSize="11" Foreground="#CBD5E1" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ProviderTitleText" Text="sevDesk API" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock x:Name="ProviderInfoText" Text="API-Token lokal verschlüsselt speichern und bei Bedarf Import-Vorschau laden."
                               FontSize="12" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>

                    <TextBlock x:Name="TokenLabelText" Text="API-Token" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TokenBox" Padding="10,8" FontSize="13" Margin="0,0,0,12"/>

                    <WrapPanel>
                        <Button x:Name="SaveTokenButton" Content="Token speichern" Click="SaveTokenButton_Click"
                                Style="{StaticResource {x:Type Button}}" Padding="16,8" Margin="0,0,10,10"/>
                        <Button x:Name="TestConnectionButton" Content="Verbindung testen" Click="TestConnectionButton_Click"
                                Style="{StaticResource {x:Type Button}}" Padding="16,8" Margin="0,0,10,10"/>
                        <Button x:Name="LoadPreviewButton" Content="Daten abrufen" Click="LoadPreviewButton_Click"
                                Style="{StaticResource AddButton}" Padding="16,8" Margin="0,0,0,10"/>
                    </WrapPanel>

                    <TextBlock x:Name="PermissionHintText" Visibility="Collapsed" FontSize="12" Foreground="#B45309" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="StatusTitleText" Text="Status" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock x:Name="StatusText" Text="Noch keine Verbindung getestet."
                                   FontSize="12" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <Separator Margin="0,12"/>
                        <TextBlock x:Name="WhatHappensTitleText" Text="Import-Ablauf" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock x:Name="WhatHappensText"
                                   Text="Vor dem Import wird immer eine Vorschau geöffnet. Dort entscheidest du, ob Kunden, Rechnungen oder nur einzelne Einträge übernommen werden."
                                   FontSize="12" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="18">
            <StackPanel>
                <TextBlock x:Name="PreviewHintTitleText" Text="Kontrollierter Import" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock x:Name="PreviewHintText"
                           Text="Die Vorschau zeigt neue und bereits vorhandene Datensätze getrennt. Standardmäßig werden nur neue Einträge vorselektiert."
                           FontSize="12" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border x:Name="BusyOverlay" Grid.RowSpan="3" Background="#A0FFFFFF" Visibility="Collapsed" Cursor="Wait">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="220" Height="8" IsIndeterminate="True"/>
                <TextBlock x:Name="BusyText" Text="Bitte warten..." Margin="0,14,0,0"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
