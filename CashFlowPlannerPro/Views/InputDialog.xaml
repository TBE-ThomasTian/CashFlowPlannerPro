<Window x:Class="CashFlowPlannerPro.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" KeyDown="Window_KeyDown">
    <Border Background="#2A2359" CornerRadius="12" Padding="32" MinWidth="400"
            BorderBrush="#812B8C" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TbLabel" FontSize="13" Foreground="#8899AA" Margin="0,0,0,12"
                       TextWrapping="Wrap"/>
            <TextBox x:Name="TbInput" Style="{StaticResource DarkTextBox}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PbInput" Padding="10,8" FontSize="14" Visibility="Collapsed"
                         Background="#1E1A40" Foreground="White" BorderBrush="#3D3670" BorderThickness="1"
                         CaretBrush="White" Margin="0,0,0,4"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Content="Abbrechen" Click="Cancel_Click" MinWidth="100"
                        Margin="0,0,12,0" Padding="12,8" FontSize="13" Cursor="Hand"
                        Background="#3D3670" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="OkBtn" Content="OK" Click="Ok_Click" MinWidth="90"
                        Padding="12,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                        Background="#BF247A" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
