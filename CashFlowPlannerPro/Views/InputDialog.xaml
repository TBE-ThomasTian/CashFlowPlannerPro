<Window x:Class="CashFlowPlannerPro.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="180"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E293B">
    <StackPanel Margin="24">
        <TextBlock x:Name="TbLabel" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8"/>
        <TextBox x:Name="TbInput" Padding="8" FontSize="13"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Click="Cancel_Click" Padding="16,6" Margin="0,0,8,0"
                    Background="Transparent" Foreground="White" BorderBrush="#475569"/>
            <Button Content="OK" Click="Ok_Click" Padding="16,6"
                    Background="#812B8C" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </StackPanel>
</Window>
