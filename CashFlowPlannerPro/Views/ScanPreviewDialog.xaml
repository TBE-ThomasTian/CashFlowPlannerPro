<Window x:Class="CashFlowPlannerPro.Views.ScanPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Scan — Rechnung" Width="1200" Height="800"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="#2A2359" MinWidth="900" MinHeight="550" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#1E1A40" Padding="20,12" MouseLeftButtonDown="TitleBar_MouseDown">
            <DockPanel>
                <Button x:Name="CloseBtn" Content="✕" Click="Cancel_Click" DockPanel.Dock="Right"
                        FontSize="18" Foreground="#8899AA" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Padding="8,0"
                        VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄  Rechnung scannen" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#1E1A40" CornerRadius="10" Padding="10,4" Margin="16,0,0,0"
                            BorderBrush="#3D3670" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Erkennung: " Foreground="#8899AA" FontSize="12"/>
                            <TextBlock x:Name="TbConfidence" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <!-- Page navigation -->
                    <Border Background="#1E1A40" CornerRadius="10" Padding="6,4" Margin="12,0,0,0"
                            BorderBrush="#3D3670" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PrevPageBtn" Content="◀" Click="PrevPage_Click" FontSize="12" Foreground="White"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,0"/>
                            <TextBlock x:Name="TbPageInfo" Text="Seite 1/1" Foreground="#8899AA"
                                       FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                            <Button x:Name="NextPageBtn" Content="▶" Click="NextPage_Click" FontSize="12" Foreground="White"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,0"/>
                            <Border Width="1" Background="#3D3670" Margin="6,2"/>
                            <Button x:Name="ZoomInBtn" Content="➕" Click="ZoomIn_Click" FontSize="10" Foreground="White"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0"/>
                            <Button x:Name="ZoomOutBtn" Content="➖" Click="ZoomOut_Click" FontSize="10" Foreground="White"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main: PDF left, Fields right -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- PDF Preview (Image) -->
            <Border Grid.Column="0" Background="#444" Margin="12,12,0,12" CornerRadius="8" ClipToBounds="True">
                <ScrollViewer x:Name="PdfScrollViewer" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" Background="#444">
                    <Image x:Name="PdfImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Top"/>
                </ScrollViewer>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- Fields -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,12,12,12"
                          Padding="0" HorizontalScrollBarVisibility="Disabled">
                <Border Background="#221E4A" CornerRadius="8" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Erkannte Daten" Foreground="#BF247A" FontSize="14"
                                   FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <!-- 2-column fields -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rechnungsnummer" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TbInvoiceNumber" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bruttobetrag (€)" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TbAmount" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rechnungsdatum" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TbInvoiceDate" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nettobetrag (€)" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TbNetAmount" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fälligkeitsdatum" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TbDueDate" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MwSt (€)" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TbVat" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Kunde" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TbCustomer" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IBAN" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TbIban" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Beschreibung" Foreground="#8899AA" FontSize="11" Margin="0,8,0,3"/>
                        <TextBox x:Name="TbDescription" Style="{StaticResource DarkTextBox}" TextWrapping="Wrap"
                                 AcceptsReturn="True" MinHeight="50" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="Zahlungsbedingungen" Foreground="#8899AA" FontSize="11" Margin="0,8,0,3"/>
                        <TextBox x:Name="TbPaymentTerms" Style="{StaticResource DarkTextBox}"/>

                        <Expander Header="  Erkannter Rohtext" Foreground="#8899AA" FontSize="11" Margin="0,12,0,0">
                            <TextBox x:Name="TbRawText" IsReadOnly="True" TextWrapping="Wrap"
                                     MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                     Background="#1E1A40" Foreground="#94A3B8" BorderBrush="#3D3670"
                                     FontSize="10" Padding="8" FontFamily="Consolas"/>
                        </Expander>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="#1E1A40" Padding="20,12">
            <DockPanel>
                <TextBlock x:Name="TbFileName" Foreground="#64748B" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="Abbrechen" Click="Cancel_Click" MinWidth="100"
                            Margin="0,0,12,0" Padding="16,9" FontSize="13" Cursor="Hand"
                            Background="#3D3670" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="AcceptBtn" Content="✅  Als Rechnung übernehmen" Click="Accept_Click" MinWidth="220"
                            Padding="16,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                            Background="#BF247A" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
