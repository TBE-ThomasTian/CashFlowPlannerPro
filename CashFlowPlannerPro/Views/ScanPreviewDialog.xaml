<Window x:Class="CashFlowPlannerPro.Views.ScanPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Scan Ergebnis" Width="1100" Height="750"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#2A2359" MinWidth="800" MinHeight="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#1E1A40" Padding="16,10" MouseLeftButtonDown="TitleBar_MouseDown">
            <DockPanel>
                <Button Content="✕" Click="Cancel_Click" DockPanel.Dock="Right"
                        FontSize="16" Foreground="#8899AA" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Padding="8,2"
                        VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄 PDF Scan — Rechnung" FontSize="16" FontWeight="Bold" Foreground="#BF247A"/>
                    <TextBlock Text="  Erkennungsrate: " Foreground="#8899AA" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbConfidence" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content: PDF left, Fields right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

            <!-- PDF Preview -->
            <WebBrowser x:Name="PdfViewer" Grid.Column="0" Margin="8"/>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" Background="#3D3670"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- Fields -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="16,12">
                <StackPanel>
                    <!-- Row 1 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rechnungsnummer" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TbInvoiceNumber" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Bruttobetrag (€)" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TbAmount" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>
                    </Grid>
                    <!-- Row 2 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rechnungsdatum" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TbInvoiceDate" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nettobetrag (€)" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TbNetAmount" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>
                    </Grid>
                    <!-- Row 3 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fälligkeitsdatum" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TbDueDate" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MwSt (€)" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TbVat" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>
                    </Grid>
                    <!-- Row 4 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kunde" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TbCustomer" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="IBAN" Foreground="#8899AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TbIban" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Beschreibung / Positionen" Foreground="#8899AA" FontSize="11" Margin="0,8,0,3"/>
                    <TextBox x:Name="TbDescription" Style="{StaticResource DarkTextBox}" TextWrapping="Wrap"
                             AcceptsReturn="True" MinHeight="60" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Zahlungsbedingungen" Foreground="#8899AA" FontSize="11" Margin="0,8,0,3"/>
                    <TextBox x:Name="TbPaymentTerms" Style="{StaticResource DarkTextBox}"/>

                    <Expander Header="Erkannter Rohtext" Foreground="#8899AA" FontSize="11" Margin="0,12,0,0">
                        <TextBox x:Name="TbRawText" IsReadOnly="True" TextWrapping="Wrap"
                                 MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                 Background="#1E1A40" Foreground="#94A3B8" BorderBrush="#3D3670"
                                 FontSize="10" Padding="8" FontFamily="Consolas"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom buttons -->
        <Border Grid.Row="2" Background="#1E1A40" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Click="Cancel_Click" MinWidth="100"
                        Margin="0,0,12,0" Padding="14,8" FontSize="13" Cursor="Hand"
                        Background="#3D3670" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="✅ Als Rechnung übernehmen" Click="Accept_Click" MinWidth="220"
                        Padding="14,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                        Background="#BF247A" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
