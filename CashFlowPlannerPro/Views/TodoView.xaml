<UserControl x:Class="CashFlowPlannerPro.Views.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ComboBox x:Name="CbFilter" Width="120" Margin="0,0,8,0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Alle" IsSelected="True"/>
                        <ComboBoxItem Content="Offen"/>
                        <ComboBoxItem Content="In Arbeit"/>
                        <ComboBoxItem Content="Erledigt"/>
                    </ComboBox>
                    <Button x:Name="AddTodoBtn" Content="➕ Neue Aufgabe" Click="AddTodo_Click"
                            Style="{StaticResource AddButton}" Padding="10,6"/>
                </StackPanel>
                <TextBlock Text="✅  Meine Aufgaben" FontSize="16" FontWeight="SemiBold"
                           Foreground="#2A2359" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Todo List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel x:Name="TodoListPanel"/>
        </ScrollViewer>
    </Grid>
</UserControl>
