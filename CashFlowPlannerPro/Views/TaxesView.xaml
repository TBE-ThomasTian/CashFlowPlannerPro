<UserControl x:Class="CashFlowPlannerPro.Views.TaxesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:CashFlowPlannerPro.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="&#x2795; Neu" Style="{StaticResource AddButton}" Command="{Binding AddCommand}" Margin="0,0,8,0"/>
                <Button Content="&#x1F5D1;&#xFE0F; Löschen" Style="{StaticResource DeleteButton}" Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Taxes}" SelectedItem="{Binding SelectedTransaction}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CellEditEnding="DataGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fälligkeitsdatum" Binding="{Binding Date}" Width="130"/>
                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Betrag &#x20AC;" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridComboBoxColumn Header="Intervall" SelectedItemBinding="{Binding Interval}" Width="150">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="sys:String">
                            <sys:String>Einmalig</sys:String>
                            <sys:String>Monatlich</sys:String>
                            <sys:String>Vierteljährlich</sys:String>
                            <sys:String>Jährlich</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
                <DataGridComboBoxColumn Header="Steuerart" SelectedItemBinding="{Binding CategoryName}" Width="170">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="sys:String">
                            <sys:String>Umsatzsteuer</sys:String>
                            <sys:String>Gewerbesteuer</sys:String>
                            <sys:String>Kapitalertragsteuer</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
