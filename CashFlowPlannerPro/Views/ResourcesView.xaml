<UserControl x:Class="CashFlowPlannerPro.Views.ResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CashFlowPlannerPro.ViewModels">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#1a1a2e" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="◀" Command="{Binding NavigatePreviousCommand}" Padding="10,4" Margin="0,0,4,0"
                        Style="{StaticResource NavButton}" ToolTip="Zurück"/>
                <Button Content="Heute" Command="{Binding NavigateTodayCommand}" Padding="10,4" Margin="0,0,4,0"
                        Style="{StaticResource NavButton}"/>
                <Button Content="▶" Command="{Binding NavigateNextCommand}" Padding="10,4" Margin="0,0,16,0"
                        Style="{StaticResource NavButton}" ToolTip="Vorwärts"/>
                <TextBlock Text="{Binding DateRangeText}" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"
                           Foreground="White" Margin="0,0,20,0"/>
                <RadioButton x:Name="RbDay" Content="Tag" GroupName="ViewMode" Foreground="White"
                             VerticalAlignment="Center" Margin="0,0,10,0" Checked="ViewMode_Checked"/>
                <RadioButton x:Name="RbWeek" Content="Woche" GroupName="ViewMode" IsChecked="True"
                             Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"
                             Checked="ViewMode_Checked"/>
                <RadioButton x:Name="RbMonth" Content="Monat" GroupName="ViewMode" Foreground="White"
                             VerticalAlignment="Center" Margin="0,0,20,0" Checked="ViewMode_Checked"/>
                <Button Content="➕ Mitarbeiter" Command="{Binding AddResourceCommand}"
                        Style="{StaticResource AddButton}" Margin="0,0,8,0" Padding="8,4"/>
                <Button Content="➕ Projekt" Command="{Binding AddProjectCommand}"
                        Style="{StaticResource AddButton}" Padding="8,4"/>
            </StackPanel>
        </Border>

        <!-- Calendar -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#F8F9FA">
            <Grid x:Name="CalendarGrid"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
