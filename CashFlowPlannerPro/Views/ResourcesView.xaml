<UserControl x:Class="CashFlowPlannerPro.Views.ResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CashFlowPlannerPro.ViewModels">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="◀" Command="{Binding NavigatePreviousCommand}" Padding="10,4" Margin="0,0,4,0"
                        Style="{StaticResource NavButton}" ToolTip="Zurück"/>
                <Button Content="Heute" Command="{Binding NavigateTodayCommand}" Padding="10,4" Margin="0,0,4,0"
                        Style="{StaticResource NavButton}"/>
                <Button Content="▶" Command="{Binding NavigateNextCommand}" Padding="10,4" Margin="0,0,16,0"
                        Style="{StaticResource NavButton}" ToolTip="Vorwärts"/>
                <TextBlock Text="{Binding DateRangeText}" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"
                           Foreground="White" Margin="0,0,20,0"/>
                <RadioButton x:Name="RbDay" Content="  Tag" GroupName="ViewMode" Foreground="White"
                             VerticalAlignment="Center" Margin="0,0,8,0" Checked="ViewMode_Checked"/>
                <RadioButton x:Name="RbWeek" Content="  Woche" GroupName="ViewMode" IsChecked="True"
                             Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"
                             Checked="ViewMode_Checked"/>
                <RadioButton x:Name="RbMonth" Content="  Monat" GroupName="ViewMode" Foreground="White"
                             VerticalAlignment="Center" Margin="0,0,16,0" Checked="ViewMode_Checked"/>
                <Button Content="➕ Mitarbeiter" Click="AddResource_Click"
                        Style="{StaticResource AddButton}" Margin="0,0,8,0" Padding="8,4"/>
                <Button Content="➕ Projekt" Click="AddProject_Click"
                        Style="{StaticResource AddButton}" Padding="8,4" Margin="0,0,8,0"/>
                <Button Content="➕ Hardware" Click="AddHardware_Click"
                        Style="{StaticResource AddButton}" Padding="8,4" Margin="0,0,8,0"/>
                <Button Content="📋 Kanban" Click="OpenKanban_Click"
                        Style="{StaticResource NavButton}" Padding="10,4"/>

                <TextBlock Text="   Ctrl+Scroll: Zoom  |  Shift+Scroll: Zeilenhöhe"
                           Foreground="#6B6490" FontSize="10" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main content: Calendar + Project List -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- Calendar -->
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource BackgroundBrush}"
                          PreviewMouseWheel="CalendarScrollViewer_PreviewMouseWheel">
                <Grid x:Name="CalendarGrid"/>
            </ScrollViewer>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="{StaticResource GridLineBrush}"
                          Cursor="SizeNS" ResizeBehavior="PreviousAndNext" Margin="0,2"/>

            <!-- Project + Hardware Lists -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Project List -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Projekte — auf Mitarbeiter-Zeile ziehen"
                                   FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="ProjectListPanel"/>
                        </ScrollViewer>
                    </DockPanel>

                    <Border Grid.Column="1" Width="1" Background="{StaticResource GridLineBrush}" Margin="8,0"/>

                    <!-- Hardware List -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="🖥 Hardware — auf Hardware-Zeile ziehen"
                                   FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="HardwareListPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
