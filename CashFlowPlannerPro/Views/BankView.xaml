<UserControl x:Class="CashFlowPlannerPro.Views.BankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" MaxHeight="180"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12"
                Padding="16,6" Margin="0,0,0,4">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="🏦 Bank" FontSize="17" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SubtitleText"
                           Text="sevDesk-Bankdaten · kein Echtzeit-Saldo"
                           FontSize="11" Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="8" Margin="0,0,0,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="285" Margin="0,0,12,0">
                    <TextBlock x:Name="AccountLabelText" Text="Zahlungskonto" FontSize="11"
                               Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox x:Name="AccountCombo" MinHeight="36"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="AccountCombo_SelectionChanged"/>
                    <TextBlock x:Name="AccountHintText" Visibility="Collapsed" Margin="0" FontSize="11"
                               Foreground="#64748B" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Width="210" MinHeight="70" Margin="0,0,12,0"
                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="BalanceLabelText" Text="sevDesk-Saldo" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="BalanceText" Text="–" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="BalanceHintText" Visibility="Collapsed" Text="Von sevDesk für dieses Zahlungskonto gemeldeter Saldo"
                                   FontSize="10" Foreground="#94A3B8" Margin="0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Width="210" MinHeight="70" Margin="0"
                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="LastSyncLabelText" Text="Letzte Synchronisierung" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="LastSyncText" Text="–" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#1E293B" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProviderHintText" Visibility="Collapsed" Text="Bankabruf erfolgt durch sevDesk/finAPI"
                                   FontSize="10" Foreground="#94A3B8" Margin="0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,8">
                    <TextBlock x:Name="FromLabelText" Text="Von" FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                    <DatePicker x:Name="FromDatePicker" Width="145"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock x:Name="ToLabelText" Text="Bis" FontSize="10" Foreground="#64748B" Margin="0,0,0,4"/>
                    <DatePicker x:Name="ToDatePicker" Width="145"/>
                </StackPanel>
                <Button x:Name="RefreshAccountsButton" Content="Konten aktualisieren"
                        Click="RefreshAccountsButton_Click" Padding="14,8" Margin="0,18,8,8"/>
                <Button x:Name="LoadTransactionsButton" Content="Kontobewegungen abrufen"
                        Click="LoadTransactionsButton_Click" Style="{StaticResource AddButton}"
                        Padding="14,8" Margin="0,18,8,8"/>
                <Button x:Name="SelectNewButton" Content="Alle neuen auswählen"
                        Click="SelectNewButton_Click" Padding="14,8" Margin="0,18,8,8"/>
                <Button x:Name="ImportButton" Content="Auswahl importieren"
                        Click="ImportButton_Click" Style="{StaticResource AddButton}"
                        Padding="14,8" Margin="0,18,8,8"/>
                <Button x:Name="CreateFixedCostButton" Content="Als Fixkosten"
                        Click="CreateFixedCostButton_Click"
                        Padding="14,8" Margin="0,18,0,8"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="StatusText" Text="Noch keine Kontobewegungen abgerufen."
                       FontSize="12" Foreground="#64748B" Margin="4,0,4,8" TextWrapping="Wrap"/>

            <DataGrid x:Name="TransactionsGrid" Grid.Row="1"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended" SelectionChanged="TransactionsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Import" Width="70" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanImport}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Wertstellung" Binding="{Binding ValueDateDisplay}" Width="110" MinWidth="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Zahlungspartner" Binding="{Binding Payee}" Width="210" MinWidth="210" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Verwendungszweck" Binding="{Binding Purpose}" Width="360" MinWidth="360" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Betrag" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120" MinWidth="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="sevDesk-Status" Binding="{Binding SourceStatus}" Width="130" MinWidth="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Importstatus" Binding="{Binding ImportState}" Width="180" MinWidth="180" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border x:Name="BusyOverlay" Grid.RowSpan="3" Background="#A0FFFFFF"
                Visibility="Collapsed" Cursor="Wait" Panel.ZIndex="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="240" Height="8" IsIndeterminate="True"/>
                <TextBlock x:Name="BusyText" Text="Bankdaten werden geladen..." Margin="0,14,0,0"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
