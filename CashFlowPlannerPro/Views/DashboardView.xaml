<UserControl x:Class="CashFlowPlannerPro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:vm="clr-namespace:CashFlowPlannerPro.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="420" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
        </Grid.RowDefinitions>

        <!-- Top Controls -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
        <StackPanel Orientation="Horizontal">
            <Label x:Name="BalanceLabel" Content="Kontostand €" VerticalAlignment="Center" Margin="0,0,4,0" Padding="0,0,0,0"/>
            <TextBox Text="{Binding StartBalance, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}" Width="120" MinHeight="34" Padding="10,4" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Label x:Name="ForecastMonthsLabel" Content="Prognose Monate" VerticalAlignment="Center" Margin="0,0,4,0" Padding="0,0,0,0"/>
            <TextBox Text="{Binding HorizonMonths, UpdateSourceTrigger=PropertyChanged}" Width="60" MinHeight="34" Padding="10,4" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox x:Name="InvoicesCheckBox" Content="Rechnungen" IsChecked="{Binding IncludeInvoices}" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Rechnungen in die Prognose einbeziehen"/>
            <CheckBox x:Name="OpenOffersCheckBox" Content="Offene Angebote" IsChecked="{Binding IncludeOffersOffen}" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Offene Angebote in die Prognose einbeziehen"/>
            <CheckBox x:Name="AssignedOffersCheckBox" Content="Beauftragte" IsChecked="{Binding IncludeOffersBeauftragt}" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Beauftragte Angebote in die Prognose einbeziehen"/>
            <CheckBox x:Name="RecurringCheckBox" Content="Wiederkehrend" IsChecked="{Binding IncludeRecurring}" VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Wiederkehrende Buchungen in die Prognose einbeziehen"/>
            <Button x:Name="RefreshButton" Content="Aktualisieren" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="12,6" MinHeight="34"/>
            <Button x:Name="SaveBalanceButton" Content="Kontostand speichern" Command="{Binding SaveBalanceCommand}" Margin="0,0,8,0" Padding="12,6" MinHeight="34"/>
            <Button x:Name="PreviewPdfButton" Content="Vorschau" Click="PreviewPdf_Click" Margin="0,0,8,0" Padding="12,6" MinHeight="34"/>
            <Button x:Name="ExportPdfButton" Content="PDF-Report" Click="ExportPdf_Click" Padding="12,6" MinHeight="34"/>
        </StackPanel>
        </Border>

        <!-- Summary Area -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KpiCard}" Margin="4">
                    <StackPanel>
                        <TextBlock x:Name="CurrentBalanceLabel" Text="Kontostand Heute" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding CurrentBalance}" Style="{StaticResource KpiValue}" Margin="0,8,0,6"/>
                        <TextBlock Text="{Binding ElementName=ForecastEndLabel, Path=Text}" Foreground="{StaticResource GrayBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KpiCard}" Margin="4">
                    <StackPanel>
                        <TextBlock x:Name="MonthlyCashflowLabel" Text="Monatl. Cashflow" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding MonthlyCashflow}" Style="{StaticResource KpiValue}" Margin="0,8,0,6"/>
                        <TextBlock Text="{Binding ElementName=HoursThisMonthLabel, Path=Text}" Foreground="{StaticResource GrayBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KpiCard}" Margin="4">
                    <StackPanel>
                        <TextBlock x:Name="OpenTodosLabel" Text="Offene ToDos" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding OpenTodos}" Style="{StaticResource KpiValue}" Margin="0,8,0,6"/>
                        <TextBlock Text="{Binding ElementName=OverdueTodosLabel, Path=Text}" Foreground="{StaticResource GrayBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KpiCard}" Margin="4">
                    <StackPanel>
                        <TextBlock x:Name="TeamUtilizationLabel" Text="Team-Auslastung" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding TeamUtilization}" Style="{StaticResource KpiValue}" Margin="0,8,0,6"/>
                        <TextBlock Text="{Binding ElementName=RunningTimersLabel, Path=Text}" Foreground="{StaticResource GrayBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="4"
                        Padding="18"
                        CornerRadius="22"
                        BorderBrush="#E5D9EC"
                        BorderThickness="1"
                        Background="#FBF8FD">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="HoursThisMonthLabel" Text="Stunden diesen Monat" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding HoursThisMonth}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding BurnRate}" Foreground="#812B8C" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock x:Name="OverdueTodosLabel" Text="Überfällige ToDos" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding OverdueTodos}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding Runway}" Foreground="{StaticResource GrayBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#E2E0E8"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Margin="0,6"/>

            <Border Grid.Column="2" Margin="4,0,4,0"
                    Padding="20"
                    CornerRadius="24"
                    BorderBrush="#473E80"
                    BorderThickness="1"
                    Background="#342B6C">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            HorizontalAlignment="Left"
                            Padding="12,8"
                            CornerRadius="999"
                            Background="#473E80">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#F2A5CC" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LiveFinanceTitleText"
                                       Text="Live-Finanzbild"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,18,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" Padding="16"
                                CornerRadius="18" Background="#4A417F" BorderBrush="#5B5294" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="ForecastEndLabel" Text="Prognose Ende" Foreground="#DED8F6" FontSize="12"/>
                                <TextBlock Text="{Binding ForecastEnd}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,8,0,6"/>
                                <TextBlock Text="{Binding MonthlyCashflow}" Foreground="#FFBB78" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Margin="10,0,0,10" Padding="16"
                                CornerRadius="18" Background="#4A417F" BorderBrush="#5B5294" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="OpenInvoicesLabel" Text="Offene Rechnungen" Foreground="#DED8F6" FontSize="12"/>
                                <TextBlock Text="{Binding OpenInvoices}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,8,0,6"/>
                                <TextBlock Text="{Binding BurnRate}" Foreground="#FFFFFF" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Margin="0,10,10,0" Padding="16"
                                CornerRadius="18" Background="#4A417F" BorderBrush="#5B5294" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="ActiveOffersLabel" Text="Aktive Angebote" Foreground="#DED8F6" FontSize="12"/>
                                <TextBlock Text="{Binding ActiveOffers}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,8,0,6"/>
                                <TextBlock Text="{Binding ElementName=MonthlyCashflowLabel, Path=Text}" Foreground="#FFFFFF" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Margin="10,10,0,0" Padding="16"
                                CornerRadius="18" Background="#4A417F" BorderBrush="#5B5294" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="RunningTimersLabel" Text="Laufende Timer" Foreground="#DED8F6" FontSize="12"/>
                                <TextBlock Text="{Binding RunningTimers}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,8,0,6"/>
                                <TextBlock Text="{Binding ElementName=TeamUtilizationLabel, Path=Text}" Foreground="#FFFFFF" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Height="96" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="MiniBar0" Grid.Column="0" VerticalAlignment="Bottom" Height="32" Margin="0,0,8,0" CornerRadius="18,18,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#BF247A" Offset="0"/>
                                    <GradientStop Color="#D9731A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="MiniBar1" Grid.Column="1" VerticalAlignment="Bottom" Height="52" Margin="0,0,8,0" CornerRadius="18,18,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#BF247A" Offset="0"/>
                                    <GradientStop Color="#D9731A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="MiniBar2" Grid.Column="2" VerticalAlignment="Bottom" Height="42" Margin="0,0,8,0" CornerRadius="18,18,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#BF247A" Offset="0"/>
                                    <GradientStop Color="#D9731A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="MiniBar3" Grid.Column="3" VerticalAlignment="Bottom" Height="74" Margin="0,0,8,0" CornerRadius="18,18,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#BF247A" Offset="0"/>
                                    <GradientStop Color="#D9731A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="MiniBar4" Grid.Column="4" VerticalAlignment="Bottom" Height="68" Margin="0,0,8,0" CornerRadius="18,18,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#BF247A" Offset="0"/>
                                    <GradientStop Color="#D9731A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="MiniBar5" Grid.Column="5" VerticalAlignment="Bottom" Height="88" Margin="0,0,8,0" CornerRadius="18,18,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#BF247A" Offset="0"/>
                                    <GradientStop Color="#D9731A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="MiniBar6" Grid.Column="6" VerticalAlignment="Bottom" Height="98" CornerRadius="18,18,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#BF247A" Offset="0"/>
                                    <GradientStop Color="#D9731A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Splitter above chart -->
        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" Background="#E2E0E8"
                      Cursor="SizeNS" ResizeBehavior="PreviousAndNext"
                      Margin="0,4"/>

        <!-- Chart -->
        <Border Grid.Row="3" Margin="0,0,0,0"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="10"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="ChartTitleText" Text="Cashflow Prognose" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock x:Name="ChartSubtitleText" Text="Netto pro Monat und kumulierte Entwicklung"
                               FontSize="11" Foreground="{StaticResource GrayBrush}"/>
                </StackPanel>

                <scottplot:WpfPlot x:Name="Chart" Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" Background="#E2E0E8"
                      Cursor="SizeNS" ResizeBehavior="PreviousAndNext"
                      Margin="0,4"/>

        <!-- Monthly Table -->
        <DataGrid Grid.Row="5" ItemsSource="{Binding MonthRows}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="MonthColumn" Header="Monat" Binding="{Binding Month}" Width="100"/>
                <DataGridTextColumn x:Name="IncomeColumn" Header="Einnahmen" Binding="{Binding Income, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn x:Name="ExpensesColumn" Header="Ausgaben" Binding="{Binding Expenses, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn x:Name="NetColumn" Header="Netto" Binding="{Binding Net, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn x:Name="CumulativeColumn" Header="Kumuliert" Binding="{Binding Cumulative, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn x:Name="TargetColumn" Header="Ziel" Binding="{Binding Target, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn x:Name="VarianceColumn" Header="Abweichung" Binding="{Binding Variance, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn x:Name="InvoiceAmountColumn" Header="Rechnungen" Binding="{Binding InvoiceAmount, StringFormat={}{0:N2}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
