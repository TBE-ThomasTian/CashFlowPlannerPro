<UserControl x:Class="CashFlowPlannerPro.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12"
                Padding="20,14" Margin="0,0,0,16">
            <TextBlock Text="🔐  Benutzerverwaltung" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Users -->
            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    Padding="16" Effect="{x:Null}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Benutzer" FontSize="16" FontWeight="Bold"
                                   Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Button x:Name="AddUserBtn" Content="➕ Neu" Click="AddUser_Click"
                                Style="{StaticResource AddButton}" Padding="8,4"
                                HorizontalAlignment="Right" Margin="8,0,0,0"/>
                    </DockPanel>
                    <StackPanel x:Name="UserListPanel"/>
                </DockPanel>
            </Border>

            <!-- Right: Roles -->
            <Border Grid.Column="2" Background="White" CornerRadius="10"
                    Padding="16" Effect="{x:Null}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Rollen &amp; Berechtigungen" FontSize="16" FontWeight="Bold"
                                   Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Button x:Name="AddRoleBtn" Content="➕ Neue Rolle" Click="AddRole_Click"
                                Style="{StaticResource AddButton}" Padding="8,4"
                                HorizontalAlignment="Right" Margin="8,0,0,0"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Ausgewählte Rolle" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" Margin="0,0,0,6"/>
                            <ComboBox x:Name="RoleSelector"
                                      SelectionChanged="RoleSelector_SelectionChanged"
                                      Width="220"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,12"
                                      Padding="8,6"/>
                            <StackPanel x:Name="RoleListPanel"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
