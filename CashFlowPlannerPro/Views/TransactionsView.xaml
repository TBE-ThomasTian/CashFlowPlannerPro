<UserControl x:Class="CashFlowPlannerPro.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:CashFlowPlannerPro.ViewModels"
             xmlns:conv="clr-namespace:CashFlowPlannerPro.Converters">
    <UserControl.Resources>
        <conv:DateDisplayConverter x:Key="DateDisplayConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddBtn" Content="&#x2795; Neu" Style="{StaticResource AddButton}" Command="{Binding AddCommand}" Margin="0,0,8,0"/>
                <Button x:Name="DeleteBtn" Content="&#x1F5D1;&#xFE0F; L&#246;schen" Style="{StaticResource DeleteButton}" Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="TransactionsGrid" Grid.Row="1" ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CellEditEnding="DataGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Datum" Binding="{Binding Date, Converter={StaticResource DateDisplayConverter}}" Width="110"/>
                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Betrag &#x20AC;" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridComboBoxColumn Header="Intervall" SelectedItemBinding="{Binding Interval}" Width="150">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="sys:String">
                            <sys:String>einmalig</sys:String>
                            <sys:String>t&#228;glich</sys:String>
                            <sys:String>w&#246;chentlich</sys:String>
                            <sys:String>monatlich</sys:String>
                            <sys:String>viertelj&#228;hrlich</sys:String>
                            <sys:String>halbj&#228;hrlich</sys:String>
                            <sys:String>j&#228;hrlich</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="Notizen" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
