<Window x:Class="CashFlowPlannerPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CashFlowPlannerPro.Views"
        Title="CashFlow Planner Pro"
        Icon="/Resources/CashFlowIcon.ico"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Logo / Title -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,20">
                    <StackPanel>
                        <Image Source="/Resources/CashFlowIcon.png" Width="40" Height="40"
                               HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock x:Name="MainTitleText" Text="CashFlow" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="MainSubtitleText" Text="Planner Pro" FontSize="12" Foreground="#64748B" Margin="0,-2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Bottom actions -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <TextBlock x:Name="SystemSectionText" Text="SYSTEM" Foreground="#475569" FontSize="10" FontWeight="Bold"
                               Margin="24,12,0,6"/>
                    <Button x:Name="ProfileButton" Content="👤  Mein Profil" Style="{StaticResource SidebarButton}"
                            Click="UserSettings_Click"/>
                    <Button x:Name="SwitchDatabaseButton" Content="⚙  Datenbank wechseln" Style="{StaticResource SidebarButton}"
                            Click="SwitchDatabase_Click"/>
                    <Button x:Name="BackupButton" Content="💾  Backup erstellen" Style="{StaticResource SidebarButton}"
                            Click="Backup_Click"/>
                    <Button x:Name="RestoreButton" Content="♻  Backup wiederherstellen" Style="{StaticResource SidebarButton}"
                            Click="Restore_Click"/>
                    <Button x:Name="CheckUpdatesButton" Content="⬇  Nach Updates suchen" Style="{StaticResource SidebarButton}"
                            Click="CheckUpdates_Click"/>
                    <Button x:Name="AboutButton" Content="ℹ  Über" Style="{StaticResource SidebarButton}"
                            Click="About_Click"/>
                    <Separator Background="#2D3F5E" Margin="16,8"/>
                    <Button x:Name="ExitButton" Content="🚪  Beenden" Style="{StaticResource SidebarButton}"
                            Click="Exit_Click"/>
                    <Separator Background="#2D3F5E" Margin="16,4"/>
                    <Border Padding="16,8" Margin="8,0">
                        <StackPanel>
                            <TextBlock x:Name="UserText" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DbText" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="NavigationSectionText" Text="NAVIGATION" Foreground="#475569" FontSize="10" FontWeight="Bold"
                                   Margin="24,0,0,6"/>
                        <Button x:Name="Nav0" Content="📊  Übersicht" Tag="dashboard:0" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav1" Content="💰  Ein/Ausgaben" Tag="transactions:1" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav2" Content="📋  Fixkosten" Tag="fixkosten:2" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav3" Content="🏛  Steuer" Tag="taxes:3" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav4" Content="📄  Rechnungen" Tag="invoices:4" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav5" Content="📝  Angebote" Tag="offers:5" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav6" Content="👥  Ressourcen" Tag="resources:6" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav7" Content="🎯  Ziele" Tag="targets:7" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav8" Content="✅  Aufgaben" Tag="todos:8" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav9" Content="⏱  Zeiterfassung" Tag="timetracking:9" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav10" Content="📇  Adressbuch" Tag="kunden:10" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="Nav11" Content="🔐  Verwaltung" Tag="admin:11" Click="NavButton_Click" Style="{StaticResource SidebarButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <TabControl x:Name="ContentTabs" Grid.Column="1" SelectedIndex="0" Background="{StaticResource BackgroundBrush}">
            <TabItem><views:DashboardView/></TabItem>
            <TabItem><views:TransactionsView/></TabItem>
            <TabItem><views:FixkostenView/></TabItem>
            <TabItem><views:TaxesView/></TabItem>
            <TabItem><views:InvoicesView/></TabItem>
            <TabItem><views:OffersView/></TabItem>
            <TabItem><views:ResourcesView/></TabItem>
            <TabItem><views:TargetsView/></TabItem>
            <TabItem><views:TodoView/></TabItem>
            <TabItem><views:TimeTrackingView/></TabItem>
            <TabItem><views:CustomersView/></TabItem>
            <TabItem><views:AdminView/></TabItem>
        </TabControl>
    </Grid>
</Window>
