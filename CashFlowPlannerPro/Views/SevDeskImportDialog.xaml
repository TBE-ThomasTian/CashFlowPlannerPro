<Window x:Class="CashFlowPlannerPro.Views.SevDeskImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sevDesk Import"
        Width="1100" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ImportGridCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="ImportTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="0,0,0,12"
                                      Background="Transparent"/>
                            <ContentPresenter Grid.Row="1"
                                              x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ImportTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#F3F0F5"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#ECE6F1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="sevDesk Import-Vorschau" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SubtitleText" Text="Hier legst du fest, welche Datensätze wirklich übernommen werden."
                           FontSize="11" Foreground="#CBD5E1" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid x:Name="SelectionContent" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16">
                <DockPanel>
                    <CheckBox x:Name="SelectAllCustomersCheckBox"
                              DockPanel.Dock="Top"
                              Margin="0,0,0,12"
                              IsThreeState="True"
                              FontWeight="SemiBold"
                              Checked="SelectAllCustomersCheckBox_Changed"
                              Unchecked="SelectAllCustomersCheckBox_Changed"/>
                    <DataGrid x:Name="CustomersGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ImportGridCheckBoxStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanImport}"
                                                  ToolTip="{Binding ImportState}"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  Click="GridSelectionCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="CustomerNumberColumn" Header="Kundennr." Binding="{Binding CustomerNumber}" Width="105"/>
                            <DataGridTextColumn x:Name="CustomerNameColumn" Header="Kunde" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn x:Name="CustomerStateColumn" Header="Status" Binding="{Binding ImportState}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#E2E0E8"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Margin="0,6"/>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16">
                <TabControl SelectedIndex="0" Style="{StaticResource ImportTabControlStyle}">
                    <TabItem x:Name="InvoicesTab" Header="Rechnungen" Style="{StaticResource ImportTabItemStyle}">
                        <DockPanel Margin="0,10,0,0">
                            <CheckBox x:Name="SelectAllInvoicesCheckBox"
                                      DockPanel.Dock="Top"
                                      Margin="0,0,0,12"
                                      IsThreeState="True"
                                      FontWeight="SemiBold"
                                      Checked="SelectAllInvoicesCheckBox_Changed"
                                      Unchecked="SelectAllInvoicesCheckBox_Changed"/>
                            <DataGrid x:Name="InvoicesGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource ImportGridCheckBoxStyle}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanImport}"
                                                          ToolTip="{Binding ImportState}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          Click="GridSelectionCheckBox_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="InvoiceNumberColumn" Header="Nummer" Binding="{Binding InvoiceNumber}" Width="140"/>
                                    <DataGridTextColumn x:Name="InvoiceCurrencyColumn" Header="Währung" Binding="{Binding CurrencyDisplay}" Width="85"/>
                                    <DataGridTextColumn x:Name="InvoiceSourceStatusColumn" Header="sevDesk Status" Binding="{Binding SourceStatus}" Width="120"/>
                                    <DataGridTextColumn x:Name="InvoiceCustomerColumn" Header="Kunde" Binding="{Binding CustomerName}" Width="*"/>
                                    <DataGridTextColumn x:Name="InvoiceDateColumn" Header="Datum" Binding="{Binding IssueDate}" Width="100"/>
                                    <DataGridTextColumn x:Name="InvoiceDueDateColumn" Header="Fällig am" Binding="{Binding DueDate}" Width="100"/>
                                    <DataGridTextColumn x:Name="InvoiceAmountColumn" Header="Brutto" Binding="{Binding AmountText}" Width="110"/>
                                    <DataGridTextColumn Header="Netto" Binding="{Binding NetAmountText}" Width="110"/>
                                    <DataGridTextColumn x:Name="InvoiceStateColumn" Header="Import" Binding="{Binding ImportState}" Width="260"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem x:Name="OffersTab" Header="Angebote" Style="{StaticResource ImportTabItemStyle}">
                        <DockPanel Margin="0,10,0,0">
                            <CheckBox x:Name="SelectAllOffersCheckBox"
                                      DockPanel.Dock="Top"
                                      Margin="0,0,0,12"
                                      IsThreeState="True"
                                      FontWeight="SemiBold"
                                      Checked="SelectAllOffersCheckBox_Changed"
                                      Unchecked="SelectAllOffersCheckBox_Changed"/>
                            <DataGrid x:Name="OffersGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource ImportGridCheckBoxStyle}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanImport}"
                                                          ToolTip="{Binding ImportState}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          Click="GridSelectionCheckBox_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="OfferNumberColumn" Header="Nummer" Binding="{Binding OfferNumber}" Width="140"/>
                                    <DataGridTextColumn x:Name="OfferCurrencyColumn" Header="Währung" Binding="{Binding CurrencyDisplay}" Width="85"/>
                                    <DataGridTextColumn x:Name="OfferSourceStatusColumn" Header="sevDesk Status" Binding="{Binding SourceStatus}" Width="130"/>
                                    <DataGridTextColumn x:Name="OfferCustomerColumn" Header="Kunde" Binding="{Binding CustomerName}" Width="*"/>
                                    <DataGridTextColumn x:Name="OfferDateColumn" Header="Datum" Binding="{Binding OfferDate}" Width="100"/>
                                    <DataGridTextColumn x:Name="OfferExpectedDateColumn" Header="Erwartet" Binding="{Binding DateExpected}" Width="100"/>
                                    <DataGridTextColumn x:Name="OfferAmountColumn" Header="Betrag" Binding="{Binding AmountText}" Width="110"/>
                                    <DataGridTextColumn x:Name="OfferProbabilityColumn" Header="Wkt. %" Binding="{Binding Probability}" Width="80"/>
                                    <DataGridTextColumn x:Name="OfferStateColumn" Header="Import" Binding="{Binding ImportState}" Width="260"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="ImportProgressPanel"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,7">
                        <TextBlock x:Name="ImportProgressCountText"
                                   DockPanel.Dock="Right"
                                   Margin="16,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GrayBrush}"
                                   Text="0 / 0"/>
                        <TextBlock x:Name="ImportProgressPhaseText"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SidebarBrush}"
                                   Text="Import wird vorbereitet"/>
                    </DockPanel>
                    <ProgressBar x:Name="ImportProgressBar"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0"
                                 IsIndeterminate="False"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Abbrechen" Click="CancelButton_Click" MinWidth="120" Margin="0,0,12,0"/>
                <Button x:Name="ImportButton" Content="Auswahl importieren" Click="ImportButton_Click" MinWidth="170" Style="{StaticResource AddButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
