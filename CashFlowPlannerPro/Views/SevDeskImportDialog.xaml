<Window x:Class="CashFlowPlannerPro.Views.SevDeskImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sevDesk Import"
        Width="1100" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ImportGridCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="sevDesk Import-Vorschau" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SubtitleText" Text="Hier legst du fest, welche Datensätze wirklich übernommen werden."
                           FontSize="11" Foreground="#CBD5E1" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16">
                <DockPanel>
                    <CheckBox x:Name="SelectAllCustomersCheckBox"
                              DockPanel.Dock="Top"
                              Margin="0,0,0,12"
                              FontWeight="SemiBold"
                              Checked="SelectAllCustomersCheckBox_Changed"
                              Unchecked="SelectAllCustomersCheckBox_Changed"/>
                    <DataGrid x:Name="CustomersGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ImportGridCheckBoxStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="GridSelectionCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="CustomerNameColumn" Header="Kunde" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn x:Name="CustomerStateColumn" Header="Status" Binding="{Binding ImportState}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#E2E0E8"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Margin="0,6"/>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16">
                <TabControl>
                    <TabItem x:Name="InvoicesTab" Header="Rechnungen">
                        <DockPanel Margin="0,10,0,0">
                            <CheckBox x:Name="SelectAllInvoicesCheckBox"
                                      DockPanel.Dock="Top"
                                      Margin="0,0,0,12"
                                      FontWeight="SemiBold"
                                      Checked="SelectAllInvoicesCheckBox_Changed"
                                      Unchecked="SelectAllInvoicesCheckBox_Changed"/>
                            <DataGrid x:Name="InvoicesGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource ImportGridCheckBoxStyle}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="GridSelectionCheckBox_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="InvoiceNumberColumn" Header="Nummer" Binding="{Binding InvoiceNumber}" Width="140"/>
                                    <DataGridTextColumn x:Name="InvoiceSourceStatusColumn" Header="sevDesk Status" Binding="{Binding SourceStatus}" Width="120"/>
                                    <DataGridTextColumn x:Name="InvoiceCustomerColumn" Header="Kunde" Binding="{Binding CustomerName}" Width="*"/>
                                    <DataGridTextColumn x:Name="InvoiceDateColumn" Header="Datum" Binding="{Binding IssueDate}" Width="100"/>
                                    <DataGridTextColumn x:Name="InvoiceDueDateColumn" Header="Fällig am" Binding="{Binding DueDate}" Width="100"/>
                                    <DataGridTextColumn x:Name="InvoiceAmountColumn" Header="Betrag" Binding="{Binding AmountText}" Width="110"/>
                                    <DataGridTextColumn x:Name="InvoiceStateColumn" Header="Import" Binding="{Binding ImportState}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem x:Name="OffersTab" Header="Angebote">
                        <DockPanel Margin="0,10,0,0">
                            <CheckBox x:Name="SelectAllOffersCheckBox"
                                      DockPanel.Dock="Top"
                                      Margin="0,0,0,12"
                                      FontWeight="SemiBold"
                                      Checked="SelectAllOffersCheckBox_Changed"
                                      Unchecked="SelectAllOffersCheckBox_Changed"/>
                            <DataGrid x:Name="OffersGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource ImportGridCheckBoxStyle}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="GridSelectionCheckBox_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="OfferNumberColumn" Header="Nummer" Binding="{Binding OfferNumber}" Width="140"/>
                                    <DataGridTextColumn x:Name="OfferSourceStatusColumn" Header="sevDesk Status" Binding="{Binding SourceStatus}" Width="130"/>
                                    <DataGridTextColumn x:Name="OfferCustomerColumn" Header="Kunde" Binding="{Binding CustomerName}" Width="*"/>
                                    <DataGridTextColumn x:Name="OfferDateColumn" Header="Datum" Binding="{Binding OfferDate}" Width="100"/>
                                    <DataGridTextColumn x:Name="OfferExpectedDateColumn" Header="Erwartet" Binding="{Binding DateExpected}" Width="100"/>
                                    <DataGridTextColumn x:Name="OfferAmountColumn" Header="Betrag" Binding="{Binding AmountText}" Width="110"/>
                                    <DataGridTextColumn x:Name="OfferProbabilityColumn" Header="Wkt. %" Binding="{Binding Probability}" Width="80"/>
                                    <DataGridTextColumn x:Name="OfferStateColumn" Header="Import" Binding="{Binding ImportState}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Abbrechen" Click="CancelButton_Click" MinWidth="120" Margin="0,0,12,0"/>
            <Button x:Name="ImportButton" Content="Auswahl importieren" Click="ImportButton_Click" MinWidth="170" Style="{StaticResource AddButton}"/>
        </StackPanel>
    </Grid>
</Window>
