<Window x:Class="CashFlowPlannerPro.Views.PasswordSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" KeyDown="Window_KeyDown">
    <Border Background="#2A2359" CornerRadius="12" Padding="32" MinWidth="400"
            BorderBrush="#812B8C" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"
                       Foreground="#BF247A" Margin="0,0,0,8"/>
            <TextBlock x:Name="HintText" Foreground="#B5BED0" FontSize="12"
                       TextWrapping="Wrap" MaxWidth="430" Margin="0,0,0,20"/>

            <TextBlock x:Name="NewPasswordLabel" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Padding="10,8" FontSize="14"
                         Background="#1E1A40" Foreground="White" BorderBrush="#3D3670" BorderThickness="1"
                         CaretBrush="White" Margin="0,0,0,12"/>

            <TextBlock x:Name="ConfirmPasswordLabel" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Padding="10,8" FontSize="14"
                         Background="#1E1A40" Foreground="White" BorderBrush="#3D3670" BorderThickness="1"
                         CaretBrush="White" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Click="Cancel_Click" MinWidth="100"
                        Margin="0,0,12,0" Padding="12,8" FontSize="13" Cursor="Hand"
                        Background="#3D3670" Foreground="White" BorderThickness="0"/>
                <Button x:Name="SaveButton" Click="Save_Click" MinWidth="100" IsDefault="True"
                        Padding="12,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                        Background="#BF247A" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
