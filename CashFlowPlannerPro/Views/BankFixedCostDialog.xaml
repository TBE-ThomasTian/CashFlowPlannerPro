<Window x:Class="CashFlowPlannerPro.Views.BankFixedCostDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bankbuchung als Fixkosten"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" KeyDown="Window_KeyDown">
    <Border Background="#2A2359" CornerRadius="12" Padding="32" MinWidth="520"
            BorderBrush="#812B8C" BorderThickness="2"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Bankbuchung als Fixkosten" FontSize="20" FontWeight="Bold"
                       Foreground="#BF247A" Margin="0,0,0,6"/>
            <TextBlock Text="Die Bankbuchung bleibt erhalten und wird eindeutig mit dem Fixkosten-Eintrag verknüpft."
                       Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Buchungsdatum" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="DateText" Style="{StaticResource DarkTextBox}" IsReadOnly="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Betrag" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="AmountText" Style="{StaticResource DarkTextBox}" IsReadOnly="True"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Beschreibung" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionText" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Intervall" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="IntervalCombo" Background="#1E1A40" Foreground="White"
                              BorderBrush="#3D3670" BorderThickness="1" FontSize="14" Padding="8,6"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kategorie (optional)" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CategoryCombo" IsEditable="False" Background="#1E1A40" Foreground="White"
                              BorderBrush="#3D3670" BorderThickness="1" FontSize="14" Padding="8,6"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Click="Cancel_Click" MinWidth="100" Margin="0,0,12,0"
                        Padding="12,8" Background="#3D3670" Foreground="White" BorderThickness="0"/>
                <Button Content="Fixkosten erstellen" Click="Save_Click" MinWidth="145"
                        Padding="12,8" Background="#BF247A" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
