<Window x:Class="CashFlowPlannerPro.Views.CustomerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kunde bearbeiten" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" KeyDown="Window_KeyDown">
    <Border Background="#2A2359" CornerRadius="12" Padding="32" MinWidth="650"
            BorderBrush="#812B8C" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="DialogTitle" Text="Kunde bearbeiten" FontSize="20" FontWeight="Bold"
                       Foreground="#BF247A" Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Firma -->
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="Firma" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbCompany" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- Ansprechpartner -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="Ansprechpartner" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbContactName" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- E-Mail / Telefon -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="E-Mail" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbEmail" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Telefon" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbPhone" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- Adresse -->
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="Adresse" Foreground="#BF247A"
                           FontSize="14" FontWeight="SemiBold" Margin="0,8,0,12"/>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="Stra&#223;e" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbStreet" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- PLZ / Ort -->
                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="PLZ" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbZipCode" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Ort" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbCity" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- Land / Steuer -->
                <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Land" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbCountry" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="USt-ID / Steuernr." Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbTaxId" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Status" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbStatus" Background="#1E1A40" Foreground="White"
                              BorderBrush="#3D3670" BorderThickness="1" FontSize="14" Padding="8,6"/>
                </StackPanel>

                <!-- Notizen -->
                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                    <TextBlock Text="Notizen" Foreground="#8899AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbNotes" Style="{StaticResource DarkTextBox}" AcceptsReturn="True"
                             Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="Abbrechen" Click="Cancel_Click" MinWidth="100"
                        Margin="0,0,12,0" Padding="12,8" FontSize="13" Cursor="Hand"
                        Background="#3D3670" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="SaveBtn" Content="Speichern" Click="Save_Click" MinWidth="100"
                        Padding="12,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                        Background="#BF247A" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
