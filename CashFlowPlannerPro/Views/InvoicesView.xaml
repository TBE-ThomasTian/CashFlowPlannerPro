<UserControl x:Class="CashFlowPlannerPro.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CashFlowPlannerPro.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <conv:FileNameConverter x:Key="FileNameConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10">
            <Button Style="{StaticResource AddButton}" Content="&#x2795; Neu" Command="{Binding AddCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource DeleteButton}" Content="&#x1F5D1; L&#246;schen" Command="{Binding DeleteCommand}"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                  CellEditEnding="DataGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ausstellungsdatum" Binding="{Binding IssueDate}" Width="120"/>
                <DataGridTextColumn Header="F&#228;llig am" Binding="{Binding DueDate}" Width="120"/>
                <DataGridTextColumn Header="Kunde" Binding="{Binding Customer}" Width="150"/>
                <DataGridTextColumn Header="Betrag &#8364;" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="200"/>
                <DataGridTextColumn Header="Bezahlt am" Binding="{Binding PaidDate}" Width="120"/>
                <DataGridTextColumn Header="Bezahlter Betrag" Binding="{Binding PaidAmount, StringFormat=N2}" Width="120"/>
                <DataGridTemplateColumn Header="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" IsEditable="False">
                                <sys:String>Offen</sys:String>
                                <sys:String>Bezahlt</sys:String>
                                <sys:String>&#220;berf&#228;llig</sys:String>
                                <sys:String>Storniert</sys:String>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="PDF Anhang" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PdfPath, Converter={StaticResource FileNameConverter}}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Button Content="&#128206;" Command="{Binding DataContext.SelectPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Padding="4,2" FontSize="11" ToolTip="PDF ausw&#228;hlen"/>
                                <Button Content="&#128194;" Command="{Binding DataContext.OpenPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Padding="4,2" FontSize="11" Margin="4,0,0,0" ToolTip="PDF &#246;ffnen"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
