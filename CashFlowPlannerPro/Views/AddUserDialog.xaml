<Window x:Class="CashFlowPlannerPro.Views.AddUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neuer Benutzer" Width="380" Height="280"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E293B">
    <StackPanel Margin="24">
        <TextBlock Text="Neuer Benutzer" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

        <TextBlock Text="Benutzername" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="TbUsername" Padding="8" FontSize="13"/>

        <TextBlock Text="Vollständiger Name" Foreground="#94A3B8" FontSize="11" Margin="0,8,0,4"/>
        <TextBox x:Name="TbFullName" Padding="8" FontSize="13"/>

        <TextBlock Text="Passwort" Foreground="#94A3B8" FontSize="11" Margin="0,8,0,4"/>
        <PasswordBox x:Name="PbPassword" Padding="8" FontSize="13"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Click="Cancel_Click" Padding="16,6" Margin="0,0,8,0"
                    Background="Transparent" Foreground="White" BorderBrush="#475569"/>
            <Button Content="Anlegen" Click="Ok_Click" Padding="16,6"
                    Background="#812B8C" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </StackPanel>
</Window>
