<UserControl x:Class="CashFlowPlannerPro.Views.OffersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CashFlowPlannerPro.Converters">
    <UserControl.Resources>
        <conv:FileNameConverter x:Key="FileNameConverter"/>
        <conv:DateDisplayConverter x:Key="DateDisplayConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddBtn" Style="{StaticResource AddButton}" Content="&#x2795; Neu" Click="Add_Click" Margin="0,0,8,0"/>
                <Button x:Name="DeleteBtn" Style="{StaticResource DeleteButton}" Content="&#x1F5D1; L&#246;schen" Click="Delete_Click" Margin="0,0,8,0"/>
                <Button x:Name="ScanPdfBtn" Style="{StaticResource NavButton}" Content="&#x1F4C4; PDF scannen" Click="ScanPdf_Click"
                        Padding="10,4" Margin="0,0,8,0"/>
                <Button x:Name="CreateProjectBtn" Style="{StaticResource NavButton}" Content="&#x1F4C1; Projekt erstellen"
                        Click="CreateProject_Click" Padding="10,4"
                        ToolTip="Aus dem ausgewählten beauftragten Angebot ein Projekt erstellen"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="OffersGrid" Grid.Row="1" ItemsSource="{Binding Offers}" SelectedItem="{Binding SelectedOffer}"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  IsReadOnly="True"
                  PreviewKeyDown="OffersGrid_PreviewKeyDown"
                  MouseDoubleClick="OffersGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Angebotsnummer" Binding="{Binding OfferNumber}" IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="Projektnummer" Binding="{Binding ProjectNumber}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="Angebotsdatum" Binding="{Binding OfferDate, Converter={StaticResource DateDisplayConverter}}" Width="120"/>
                <DataGridTextColumn Header="Erwartetes Datum" Binding="{Binding DateExpected, Converter={StaticResource DateDisplayConverter}}" Width="120"/>
                <DataGridTextColumn Header="Kunde" Binding="{Binding Customer}" Width="170"/>
                <DataGridTextColumn Header="Ausgangsbetrag &#8364;" Binding="{Binding AmountBeforeDiscount, StringFormat=N2}" Width="135"/>
                <DataGridTextColumn Header="Rabatt %" Binding="{Binding DiscountPercent, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Endbetrag &#8364;" Binding="{Binding Amount, StringFormat=N2}" Width="115"/>
                <DataGridTextColumn Header="Wahrscheinlichkeit %" Binding="{Binding Probability}" Width="130"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="200"/>
                <DataGridTextColumn Header="Zahlungsziel Tage" Binding="{Binding PaymentDelay}" Width="130"/>
                <DataGridTemplateColumn Header="PDF Anhang" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PdfPath, Converter={StaticResource FileNameConverter}}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Button Content="&#128206;" Command="{Binding DataContext.SelectPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        IsEnabled="{Binding DataContext.CanEditOffers, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Padding="4,2" FontSize="11" ToolTip="PDF anh&#228;ngen / Attach PDF"/>
                                <Button Content="&#128194;" Command="{Binding DataContext.OpenPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Padding="4,2" FontSize="11" Margin="4,0,0,0" ToolTip="PDF &#246;ffnen / Open PDF"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="BusyOverlay"
                Grid.RowSpan="2"
                Panel.ZIndex="10"
                Background="#A0FFFFFF"
                Cursor="Wait"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Width="220"
                             Height="8"
                             IsIndeterminate="True"/>
                <TextBlock x:Name="OffersBusyText"
                           Text="Angebote werden geladen..."
                           Margin="0,14,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
