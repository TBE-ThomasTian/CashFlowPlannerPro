<Application x:Class="CashFlowPlannerPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CashFlowPlannerPro.Converters"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ColorConverter x:Key="ColorConverter"/>
            <conv:CurrencyConverter x:Key="CurrencyConverter"/>
            <conv:AmountColorConverter x:Key="AmountColorConverter"/>
            <conv:FileNameConverter x:Key="FileNameConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
