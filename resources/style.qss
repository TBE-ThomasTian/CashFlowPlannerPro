/* Solid Color Theme - No Transparency for Flicker-Free Rendering */

/* Main Window - Solid Background */
QMainWindow {
    background-color: #0F1419;
}

/* All Widgets - Solid Background */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    color: #E2E8F0;
    background-color: #0F1419;
}

/* Tab Widget */
QTabWidget::pane {
    background-color: #0F1419;
    border: none;
}

QTabBar {
    background-color: #0F1419;
}

QTabBar::tab {
    background-color: #1E293B;
    color: #94A3B8;
    padding: 12px 28px;
    margin: 0 4px;
    border: 1px solid #2E3A4A;
    border-radius: 12px;
    font-weight: 500;
    min-width: 120px;
}

QTabBar::tab:selected {
    background-color: #3B82F6;
    color: white;
    border: none;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #2563EB;
    color: #E2E8F0;
}

/* Card Style - Solid Background */
QFrame#Card {
    background-color: #1E293B;
    border: 2px solid #2E3A4A;
    border-radius: 16px;
}

/* KPI Labels */
QLabel#CardTitle {
    background-color: #1E293B;
    color: #94A3B8;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.8px;
}

QLabel#CardValue {
    background-color: #1E293B;
    color: #F8FAFC;
    font-size: 32px;
    font-weight: 700;
}

/* Buttons - Solid Colors */
QPushButton {
    background-color: #3B82F6;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-weight: 600;
    font-size: 14px;
    min-height: 38px;
}

QPushButton:hover {
    background-color: #2563EB;
}

QPushButton:pressed {
    background-color: #1D4ED8;
}

QPushButton#SecondaryButton {
    background-color: #475569;
    color: #E2E8F0;
}

QPushButton#SecondaryButton:hover {
    background-color: #64748B;
}

QPushButton[text="Löschen"] {
    background-color: #DC2626;
}

QPushButton[text="Löschen"]:hover {
    background-color: #B91C1C;
}

QPushButton[text="Speichern"] {
    background-color: #059669;
}

QPushButton[text="Speichern"]:hover {
    background-color: #047857;
}

/* Tables - Solid Background */
QTableWidget, QTableView {
    background-color: #1A202C;
    alternate-background-color: #1E293B;
    border: 2px solid #2E3A4A;
    border-radius: 12px;
    gridline-color: #2E3A4A;
    selection-background-color: #3B82F6;
}

QTableWidget::item, QTableView::item {
    padding: 10px;
    background-color: #1A202C;
    color: #E2E8F0;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #3B82F6;
    color: white;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #2D3748;
}

/* Table Headers */
QHeaderView::section {
    background-color: #2D3748;
    color: #CBD5E1;
    padding: 12px;
    border: none;
    font-weight: 600;
    font-size: 12px;
}

/* Input Fields - Solid Background */
QSpinBox, QDoubleSpinBox {
    background-color: #1E293B;
    border: 2px solid #3E4A5A;
    border-radius: 8px;
    padding: 8px 12px;
    color: #F8FAFC;
    font-size: 14px;
    min-height: 36px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #3B82F6;
    background-color: #2D3748;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 2px solid #64748B;
}

/* Spin Box Buttons */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #2D3748;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #3E4A5A;
}

/* Labels */
QLabel {
    background-color: #0F1419;
    color: #E2E8F0;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #1A202C;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #475569;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748B;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #1A202C;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #475569;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #64748B;
}

/* Chart View */
QChartView {
    background-color: #1A202C;
    border: 2px solid #2E3A4A;
    border-radius: 12px;
}

/* Tooltips */
QToolTip {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 2px solid #3E4A5A;
    border-radius: 8px;
    padding: 8px;
}